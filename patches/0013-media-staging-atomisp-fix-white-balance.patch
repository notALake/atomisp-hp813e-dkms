+/*
+ * Default white balance gains.
+ *
+ * On the HP Pavilion x2 (board 813E) the whole pipeline runs in raw Bayer
+ * (SGRBG10) up to the Intel ISP and there is no 3A/AWB daemon on Linux, so
+ * these compile-time defaults are the only white balance ever applied.
+ *
+ * Format is {integer_bits, gr, r, b, gb} with gains expressed as
+ * u<integer_bits>.<16-integer_bits> fixed point: with integer_bits == 2 the
+ * value 16384 means 1.0 (range up to 65535 == ~4.0).
+ *
+ * NOTE: on this ISP the "r" field is the BLUE channel gain and the "b"
+ * field is the RED channel gain (verified experimentally: raising wb_r
+ * makes the picture blue, raising wb_b makes it red).  The stock 1.0/1.0
+ * defaults therefore yield a clearly yellow-green cast (blue is too low
+ * for this sensor/illuminant pair), which is compensated below.
+ *
+ * The values are exposed as module parameters so the white balance can be
+ * tuned at runtime without rebuilding/reinstalling the module, for example:
+ *
+ *     echo 27200 | sudo tee /sys/module/atomisp/parameters/wb_r
+ *     echo 17720 | sudo tee /sys/module/atomisp/parameters/wb_b
+ *
+ * The ISP stream (and therefore these defaults) is recreated on every
+ * capture session, so new values are picked up at the next STREAMON.
+ */
+static unsigned int wb_integer_bits = 2;
+static unsigned int wb_gr = 16384;	/* Gr == 1.00 */
+static unsigned int wb_r  = 27200;	/* blue == 1.66 */
+static unsigned int wb_b  = 17720;	/* red  == 1.08 */
+static unsigned int wb_gb = 16384;	/* Gb == 1.00 */
+
+/* tuned by eye with the saturation boost (patch 0015) active: that boost
+ * multiplies the residual colour cast too, so these two gains are chosen
+ * where the white background stays neutral at saturation 180. */
+module_param(wb_integer_bits, uint, 0644);
+module_param(wb_gr, uint, 0644);
+module_param(wb_r,  uint, 0644);
+module_param(wb_b,  uint, 0644);
+module_param(wb_gb, uint, 0644);
+
+const struct ia_css_wb_config *ia_css_default_wb_config(void)
+{
+	static struct ia_css_wb_config cfg;
+
+	cfg.integer_bits = wb_integer_bits;
+	cfg.gr = wb_gr;
+	cfg.r  = wb_r;
+	cfg.b  = wb_b;
+	cfg.gb = wb_gb;
+	return &cfg;
+}
 

+/*
+ * Colour saturation of the YUV output, as a percentage of the standard
+ * BT.601 chroma amplitude (100 == unchanged, 0 == greyscale, 180 == default).
+ *
+ * On the HP Pavilion x2 (board 813E) the whole pipeline runs in raw Bayer up
+ * to the Intel ISP and there is no 3A/colour-correction daemon on Linux, so
+ * the colours come out washed out: this scales the U/V rows of the RGB to YUV
+ * matrix (row 0, the luma, is left alone).
+ *
+ * Exposed as a module parameter so it can be tuned at runtime, for example:
+ *
+ *     echo 140 | sudo tee /sys/module/atomisp/parameters/saturation
+ *
+ * The ISP stream (and therefore this matrix) is recreated on every capture
+ * session, so new values are picked up at the next STREAMON.
+ */
+static unsigned int saturation = 180;	/* chosen by eye on this panel */
+module_param(saturation, uint, 0644);
+
+const struct ia_css_cc_config *ia_css_default_rgb2yuv_config(void)
+{
+	static struct ia_css_cc_config cfg;
+	unsigned int i;
+	unsigned int s = saturation;
+
+	/*
+	 * Coefficients are s[13-fraction_bits].[fraction_bits]; keep |v| < 8192.
+	 * The 64-bit cast is needed: matrix[] is signed but s is unsigned, and a
+	 * plain "matrix[i] * s" would promote the product to unsigned, turning
+	 * the negative coefficients into huge positive values (totally magenta).
+	 */
+	if (s > 190)
+		s = 190;
+
+	cfg = default_rgb2yuv_cc_config;
+	for (i = 3; i < 9; i++)	/* rows 1 and 2 are U and V (chroma) */
+		cfg.matrix[i] = (s32)((long long)cfg.matrix[i] * s / 100);
+	return &cfg;
+}
+
 void
